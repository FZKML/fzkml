                "outcome": {
                  "enum": [
                    "successful",
                    "failed",
                    "inconclusive",
                    "unsupported",
                    "canceled"
                  ]
                },
                "observations": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "single_release_ratio": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "composed_ratio": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "fresh_releases": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2
                    },
                    "ticket_count": {
                      "const": 766
                    },
                    "system_dp_established": {
                      "const": false
                    }
                  },
                  "required": [
                    "single_release_ratio",
                    "composed_ratio",
                    "fresh_releases",
                    "ticket_count",
                    "system_dp_established"
                  ]
                },
                "limits": {
                  "const": "Exact finite cyclic reference law and conditional ratio accountant only. Ideal secret independent tickets assumed; production sampler, full transcript DP and theorem review pending."
                }
              },
              "required": [
                "contract_id",
                "issue",
                "fixture_ids",
                "outcome",
                "observations",
                "limits"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "contract_id": {
                  "const": "CI-20"
                },
                "issue": {
                  "const": 115
                },
                "fixture_ids": {
                  "const": [
                    "ci20-synthetic-matrix",
                    "ci20-quota-mutants"
                  ]
                },
                "outcome": {
                  "enum": [
                    "successful",
                    "failed",
                    "inconclusive",
                    "unsupported",
                    "canceled"
                  ]
                },
                "observations": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "matrix_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "totals": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "jobs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65536
                        },
                        "attempts": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65536
                        },
                        "serial_seconds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65536
                        },
                        "cpu_seconds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65536
                        },
                        "gpu_seconds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65536
                        },
                        "concurrent_ram_mib": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65536
                        },
                        "concurrent_disk_mib": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65536
                        },
                        "cumulative_disk_mib": {
