            "approved": false
          }
        },
        "scientific_claim_ids": {
          "const": []
        },
        "records": {
          "const": []
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "dirty": {
              "type": "boolean"
            },
            "files": {
              "type": "object",
              "minProperties": 10,
              "maxProperties": 32,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "required": [
            "commit",
            "dirty",
            "files"
          ]
        }
