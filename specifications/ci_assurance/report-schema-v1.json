{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fzkml.org/specifications/ci-assurance/report/1.0.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "synthetic-engineering-reference"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "dirty": {
              "type": "boolean"
            },
            "files": {
              "type": "object",
              "minProperties": 10,
              "maxProperties": 32,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "required": [
            "commit",
            "dirty",
            "files"
          ]
        },
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "execution_kind": {
          "const": "reference-process"
        },
        "workflow_run_id": {
          "type": "null"
        },
        "workflow_job_id": {
          "type": "null"
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approved": {
              "const": false
            }
          },
          "required": [
            "approved"
          ]
        },
        "scientific_claim_ids": {
          "const": []
        },
        "records": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "contract_id": {
                  "const": "CI-16"
                },
                "issue": {
                  "const": 111
                },
                "fixture_ids": {
                  "const": [
                    "ci16-baseline",
                    "ci16-duplicates",
                    "ci16-reordered",
                    "ci16-restart",
                    "ci16-timeout",
                    "ci16-dropped-share",
                    "ci16-released-timeout"
                  ]
                },
                "outcome": {
                  "enum": [
                    "successful",
                    "failed",
                    "inconclusive",
                    "unsupported",
                    "canceled"
                  ]
                },
                "observations": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "traces": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "maxLength": 64
                          },
                          "classification": {
                            "enum": [
                              "released",
                              "aborted-before-disclosure",
                              "aborted-possible-disclosure",
                              "inconclusive"
                            ]
                          },
                          "charged": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "releases": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "accepted": {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "maxLength": 64
                              },
                              "minItems": 2,
                              "maxItems": 2
                            },
                            "minItems": 0,
                            "maxItems": 2
                          }
                        },
