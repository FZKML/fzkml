                  "required": [
                    "traces",
                    "production_protocol_executed"
                  ]
                },
                "limits": {
                  "const": "Synthetic receipt/state abstraction only: no protected aggregation, cryptographic admission, durable database or real share failure exercised."
                }
              },
              "required": [
                "contract_id",
                "issue",
                "fixture_ids",
                "outcome",
                "observations",
                "limits"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "contract_id": {
                  "const": "CI-17"
                },
                "issue": {
                  "const": 112
                },
                "fixture_ids": {
                  "const": [
                    "ci17-finite-bfs",
                    "ci17-concurrent",
                    "ci17-double-release-mutant"
                  ]
                },
                "outcome": {
                  "enum": [
                    "successful",
                    "failed",
                    "inconclusive",
                    "unsupported",
                    "canceled"
                  ]
                },
                "observations": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "states": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4096
                    },
                    "edges": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65536
                    },
                    "linearized_events": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 256
                    },
                    "production_consensus_executed": {
                      "const": false
                    }
                  },
                  "required": [
                    "states",
                    "edges",
                    "linearized_events",
                    "production_consensus_executed"
                  ]
                },
                "limits": {
                  "const": "Finite two-client two-share single-authority abstraction; trusted authenticated latest atomic state and one canonical head assumed. No Byzantine consensus, liveness or production implementation proof."
                }
              },
              "required": [
                "contract_id",
                "issue",
                "fixture_ids",
                "outcome",
                "observations",
                "limits"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "contract_id": {
                  "const": "CI-18"
                },
                "issue": {
                  "const": 113
                },
                "fixture_ids": {
                  "const": [
                    "ci18-five-public-views",
                    "ci18-known-canary-mutants"
                  ]
                },
                "outcome": {
                  "enum": [
                    "successful",
                    "failed",
                    "inconclusive",
                    "unsupported",
                    "canceled"
                  ]
                },
                "observations": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "files_scanned": {
                      "type": "integer",
                      "minimum": 5,
                      "maximum": 32
                    },
                    "bytes_scanned": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4194304
                    },
                    "semantic_confidentiality_established": {
                      "const": false
                    }
                  },
                  "required": [
                    "files_scanned",
                    "bytes_scanned",
                    "semantic_confidentiality_established"
                  ]
                },
                "limits": {
                  "const": "Known synthetic byte/hex/base64/percent canaries and inventoried public files only. No semantic/computational confidentiality or exhaustive observer-view proof."
                }
              },
              "required": [
                "contract_id",
                "issue",
                "fixture_ids",
                "outcome",
                "observations",
                "limits"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "contract_id": {
                  "const": "CI-19"
