                  "required": [
                    "matrix_digest",
                    "totals",
                    "rows",
                    "dispatch_authorized",
                    "review_scope"
                  ]
                },
                "limits": {
                  "const": "Offline synthetic quota arithmetic only; synthetic digest trust anchor is a test fixture, human/live approvals empty, no dispatch or hardware allocation supported."
                }
              },
              "required": [
                "contract_id",
                "issue",
                "fixture_ids",
                "outcome",
                "observations",
                "limits"
              ]
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
