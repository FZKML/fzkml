{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_path": {
      "const": "claims/registry.json"
    },
    "registry_schema": {
      "const": "claims/schema-v1.json"
    },
    "source_map_path": {
      "const": "claims/source-map-v1.json"
    },
    "source_map_schema": {
      "const": "claims/source-map-schema-v1.json"
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ]
      },
      "maxItems": 5000
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "path",
        "sha256"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "maxItems": 5000
          },
          "source_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "source_inspection": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "relation_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "specification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "implementation": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_commit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "required": [
                "path",
                "sha256",
                "source_commit"
              ]
            },
            "maxItems": 5000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "maxItems": 5000
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "required_reviews": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "maxItems": 5000
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "maxItems": 5000
          }
        },
        "required": [
          "claim_id",
          "source_refs",
          "source_version",
          "source_inspection",
          "relation_id",
          "specification",
          "implementation",
          "evidence_ids",
          "author",
          "required_reviews",
          "limitations"
        ]
      },
      "maxItems": 5000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "kind": {
            "enum": [
              "specification",
              "unit-test",
              "experiment",
              "formal-proof",
              "independent-review",
              "reference"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "source_commit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "execution": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "observed-github-actions",
                      "trusted-checker-receipt"
                    ]
                  },
                  "outcome": {
                    "enum": [
                      "successful",
                      "failed",
                      "inconclusive",
                      "not-run"
                    ]
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "run_url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "source_commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "kind",
                  "outcome",
                  "command",
                  "run_url",
                  "source_commit",
                  "scope"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "formal": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "statement_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "statement_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "kernel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "kernel_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "axioms": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "maxItems": 5000
                  },
                  "checked_artifact": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ]
                  },
                  "receipt": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ]
                  },
                  "source_commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "checker_exit_code": {
                    "const": 0
                  },
                  "claim_binding_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "statement_id",
                  "statement_sha256",
                  "kernel",
                  "kernel_version",
                  "axioms",
                  "checked_artifact",
                  "receipt",
                  "source_commit",
                  "checker_exit_code",
                  "claim_binding_sha256"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "review": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reviewer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "independent_from": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "maxItems": 5000
                  },
                  "date": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "artifact": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ]
                  },
                  "reviewed_source_commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "claim_binding_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "reviewer",
                  "independent_from",
                  "date",
                  "scope",
                  "artifact",
                  "reviewed_source_commit",
                  "claim_binding_sha256"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "replication": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "result",
                  "result_schema",
                  "raw_artifacts",
                  "operator",
                  "independent_from",
                  "reproduces_evidence_id"
                ],
                "properties": {
                  "result": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  },
                  "result_schema": {
                    "enum": [
                      "1.0.0",
                      "1.1.0"
                    ]
                  },
                  "raw_artifacts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "sha256"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  },
                  "operator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "independent_from": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "reproduces_evidence_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "required": [
          "evidence_id",
          "kind",
          "path",
          "sha256",
          "scope",
          "source_commit",
          "execution",
          "formal",
          "review",
          "replication"
        ]
      },
      "maxItems": 5000
    }
  },
  "required": [
    "schema_version",
    "registry_path",
    "registry_schema",
    "source_map_path",
    "source_map_schema",
    "source_version",
    "relations",
    "protocol",
    "records",
    "evidence"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FZKML/fzkml/claims/traceability-schema-v1.json"
}
