                    "actual_output",
                    "actual_proof_bytes",
                    "cases",
                    "setup_seconds",
                    "witness_seconds",
                    "prove_seconds",
                    "negative_setup_and_prove_seconds",
                    "contract_digest",
                    "program_digest",
                    "dependency_digest",
