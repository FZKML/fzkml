                    "parameters_digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "actual_output": {
                      "const": 9
                    },
                    "actual_proof_bytes": {
                      "const": 128
                    },
                    "cases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "case": {
                            "enum": [
                              "positive",
                              "development",
                              "mock",
                              "substituted-key",
                              "forged-key-tag",
                              "fake-proof",
                              "changed-output",
                              "trailing-byte",
                              "skipped",
                              "unsupported",
                              "canceled"
                            ]
                          },
                          "nominal_exit_code": {
                            "const": 0
