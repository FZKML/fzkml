        "dependency_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "source_commit",
        "source_dirty",
        "execution_kind",
        "workflow_run",
        "workflow_ref",
        "python",
        "rust",
        "uv",
        "hardware",
        "dependency_digest"
      ]
    },
    "fixture_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preprocessor_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relation_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "program_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "field_study_status": {
      "const": "not-run"
