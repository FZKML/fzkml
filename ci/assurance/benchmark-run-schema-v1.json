                              ]
                            }
                          },
                          "required": [
                            "status",
                            "exit_code",
                            "wall_seconds",
                            "queue_seconds",
                            "cpu_seconds",
                            "peak_process_rss_bytes",
                            "stdin_bytes",
                            "stdout_bytes",
                            "client",
                            "source",
                            "virtual_profile",
                            "emulated_delay_ms",
                            "update"
                          ]
                        },
                        "maxItems": 3
