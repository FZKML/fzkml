                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 240
                    }
                  ]
                },
                "certified_time_to_quality_seconds": {
                  "type": "null"
                },
