{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FZKML/fzkml/ci/assurance/benchmark-run-schema-v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "issue": {
      "const": 106
    },
    "status": {
      "enum": [
        "running",
        "failed",
        "completed-diagnostic-field-study-not-run"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_dirty": {
          "type": "boolean"
        },
        "execution_kind": {
          "enum": [
            "local",
            "github-actions"
          ]
        },
        "workflow_run": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "workflow_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          ]
        },
        "python": {
          "const": "3.11.14"
        },
        "rust": {
          "const": "1.85.1"
        },
        "uv": {
          "const": "0.9.11"
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "architecture": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "os": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "logical_cpus": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            },
            "execution_hosts": {
              "const": 1
            },
            "physical_hardware_inventory": {
              "const": "not-verified"
            },
            "accelerator": {
              "const": "none"
            },
            "processor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "memory_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000000000000
            },
            "runner_image_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "architecture",
            "os",
            "logical_cpus",
            "execution_hosts",
            "physical_hardware_inventory",
            "accelerator",
            "processor",
            "memory_bytes",
            "runner_image_revision"
          ]
