                            "source": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1000
                            },
                            "virtual_profile": {
                              "enum": [
                                "emulated-slow",
                                "same-host-normal"
                              ]
                            },
                            "emulated_delay_ms": {
                              "enum": [
                                0,
                                10,
                                200
                              ]
                            },
                            "update": {
                              "anyOf": [
                                {
                                  "type": "null"
