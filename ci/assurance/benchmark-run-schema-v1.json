                      "output": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "integer"
                          }
                        ]
                      },
                      "quality_squared_loss": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          }
                        ]
                      },
                      "numeric_time_to_quality_seconds": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240
                          }
                        ]
                      },
                      "certified_time_to_quality_seconds": {
                        "type": "null"
