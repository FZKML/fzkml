                          "native_verifier_called": {
                            "type": "boolean"
                          },
                          "verification_seconds": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 120
                          },
                          "proof_bytes": {
                            "type": "integer",
                            "minimum": 128,
                            "maximum": 129
                          },
                          "declared_key_digest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "key_matches_controller": {
                            "type": "boolean"
