                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "requested_local_only_training": {
                  "const": "not-run"
                },
                "sample": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "completed",
                        "failed",
                        "timeout"
