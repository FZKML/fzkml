                    "candidate": {
                      "enum": [
                        "positive",
                        "development",
                        "mock",
                        "substituted-key",
                        "forged-key-tag",
                        "fake-proof",
                        "changed-output",
                        "trailing-byte",
                        "skipped",
                        "unsupported",
                        "canceled"
