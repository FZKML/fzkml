                        },
                        "required": [
                          "case",
                          "nominal_exit_code",
                          "mode",
                          "status",
                          "accepted",
                          "native_verifier_called",
                          "verification_seconds",
                          "proof_bytes",
                          "declared_key_digest",
                          "key_matches_controller"
                        ]
                      },
                      "minItems": 11,
                      "maxItems": 11
                    },
                    "setup_seconds": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 120
                    },
                    "witness_seconds": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 120
                    },
                    "prove_seconds": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 120
                    },
                    "negative_setup_and_prove_seconds": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 120
                    },
                    "contract_digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "program_digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "dependency_digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "core_digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "limitations": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
