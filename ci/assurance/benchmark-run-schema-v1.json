                          "mode": {
                            "enum": [
                              "research-real",
                              "development",
                              "mock"
                            ]
                          },
                          "status": {
                            "enum": [
                              "executed",
                              "skipped",
                              "unsupported",
                              "canceled"
                            ]
                          },
                          "accepted": {
                            "type": "boolean"
