                            },
                            "exit_code": {
                              "type": "integer"
                            },
                            "wall_seconds": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 240
                            },
                            "queue_seconds": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 240
                            },
                            "cpu_seconds": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 240
                            },
                            "peak_process_rss_bytes": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "stdin_bytes": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "stdout_bytes": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "client": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1000
