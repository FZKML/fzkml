{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FZKML/fzkml/schemas/claims-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FZK-[A-Z0-9]+-C[0-9]{2}-[A-Z0-9]+-[0-9]{3}$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "edition": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "chapter": {
                "type": "integer",
                "minimum": 1,
                "maximum": 80
              },
              "section": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "equation": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            },
            "required": [
              "edition",
              "chapter",
              "section",
              "equation",
              "version"
            ]
          },
          "kind": {
            "enum": [
              "definition",
              "assumption-theorem",
              "cryptographic-security",
              "implementation-relation",
              "empirical-hypothesis",
              "published-reference",
              "adoption-outcome"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence_class": {
            "enum": [
              "specification",
              "implementation-conformance",
              "empirical",
              "formal",
              "reference",
              "human-review"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "responsible_issue": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "planned",
              "specified",
              "implemented",
              "tested",
              "replicated",
              "reviewed",
              "refuted",
              "inconclusive",
              "unsupported",
              "deferred"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "formal_proof": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "minItems": 0,
                "maxItems": 1000,
                "uniqueItems": true
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "minItems": 0,
                "maxItems": 1000,
                "uniqueItems": true
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "artifact_ids",
              "assumptions",
              "scope"
            ]
          },
          "independent_review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "minItems": 0,
                "maxItems": 1000,
                "uniqueItems": true
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "artifact_ids",
              "scope"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "observer": {
            "enum": [
              "server",
              "client",
              "aggregator",
              "external",
              "not-applicable"
            ]
          },
          "privacy_unit": {
            "enum": [
              "record",
              "client",
              "user",
              "organization",
              "not-applicable"
            ]
          },
          "numerical_semantics": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "required": [
          "id",
          "source",
          "kind",
          "statement",
          "evidence_class",
          "scope",
          "assumptions",
          "owner",
          "responsible_issue",
          "status",
          "evidence_ids",
          "formal_proof",
          "independent_review",
          "limitations",
          "observer",
          "privacy_unit",
          "numerical_semantics"
        ]
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "kind": {
            "enum": [
              "specification",
              "unit-test",
              "experiment",
              "formal-proof",
              "independent-review",
              "reference"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./:-]{1,200}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "scope"
        ]
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "claims",
    "evidence"
  ]
}
