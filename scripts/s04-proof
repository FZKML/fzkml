#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
uv sync --locked
cargo build --release --locked -p fzkml-core --bin fzkml-contract
wheel_dir="$(mktemp -d)"
trap 'rm -rf "$wheel_dir"' EXIT
(
  cd bindings
  if [[ "$(uname -s)" == Linux ]]; then
    ../.venv/bin/maturin build --release --locked --out "$wheel_dir" -i ../.venv/bin/python --compatibility linux
  else
    ../.venv/bin/maturin build --release --locked --out "$wheel_dir" -i ../.venv/bin/python
  fi
)
wheel=$(find "$wheel_dir" -maxdepth 1 -name 'fzkml_native-*.whl' -print -quit)
test -n "$wheel"
uv pip install --python .venv/bin/python --no-deps --reinstall "$wheel"
PYTHONPATH=.:src uv run --locked python scripts/s04_proof.py
