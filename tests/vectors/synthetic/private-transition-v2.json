  "contract_snapshot_json": "{\n  \"contract_version\": \"fzk-private-2.0.0\",\n  \"numeric_contract\": \"fzknum-1.0.0\",\n  \"computation\": \"the complete three-client fixed16 linear update and weighted full-state aggregate from numeric-contract-v1.json\",\n  \"witness\": [\n    \"initial full-state weight\",\n    \"three x values\",\n    \"three y values\",\n    \"independent secret 32-byte model and data blindings\"\n  ],\n  \"public\": [\n    \"numeric relation digest\",\n    \"session and strictly increasing round\",\n    \"parent receipt\",\n    \"parent full-state value\",\n    \"ordered roster and aggregation weights\",\n    \"model, preprocessing, initialization, local-step, data-policy and optimizer identifiers\",\n    \"verifying-key identifier\",\n    \"model commitment\",\n    \"data commitment\",\n    \"full-state output\"\n  ],\n  \"parent_link\": \"The caller supplies a trusted ExpectedTransition built from the authorized genesis or last accepted statement. The public parent_value is constrained in-circuit equal to the private initial weight. For later rounds, TransitionChain requires parent receipt = SHA256(canonical previous statement), parent_value = previous full-state output, round = previous round + 1, and unchanged session, roster, algorithm identifiers and key. Counts may change within the validated 1..4 range.\",\n  \"parent_value_range\": \"The context parser accepts a full-state value in [-80,80]. The implemented fzknum-1.0.0 initial weight is more narrowly bounded to [-32,32]; prepare() rejects parent values outside that input domain, and the circuit also requires equality to its bounded private weight.\",\n  \"wire_versions\": {\n    \"context\": \"FZKCTX02\",\n    \"statement\": \"FZKSTA02\",\n    \"envelope\": \"FZKPRF02 || 02 00 00 00\"\n  },\n  \"domain_input\": \"The circuit constrains the public field domain input to the integer represented by the first 31 bytes, little-endian, of SHA256(the exact bytes of this contract JSON).\",\n  \"model_commitment\": \"SHA256(FZKMOD02 || secret_model_blinding_32 || context_sha256_32 || i64le(initial_weight))\",\n  \"data_commitment\": \"SHA256(FZKDAT02 || secret_data_blinding_32 || context_sha256_32 || concat_i(i64le(x_i) || i64le(y_i)))\",\n  \"hiding_assumption\": \"Computational hiding in the random-oracle model with independent uniform secret 256-bit blindings; collision resistance alone does not establish hiding.\",\n  \"binding_assumption\": \"SHA-256 collision resistance plus proof/extraction and trusted-setup assumptions.\",\n  \"randomness_policy\": \"Fresh OS entropy for each opening and proof; fail closed on entropy failure; never publish/reuse blindings; no secure-erasure guarantee.\",\n  \"configuration_ids\": {\n    \"model\": \"SHA256(fzkml.model.linear-1x1.no-bias.v1)\",\n    \"preprocessing\": \"SHA256(fzkml.preprocessing.identity.v1)\",\n    \"initialization\": \"SHA256(fzkml.initialization.authorized-parent-value.v1)\",\n    \"data_policy\": \"SHA256(fzkml.data.synthetic-identity-three-client.v1)\",\n    \"optimizer\": \"SHA256(fzkml.optimizer.fixed16.sgd-1of4.v1)\",\n    \"local_step_count\": 1\n  },\n  \"backend\": \"ark-groth16 0.5.0 over BN254, local random setup; keys and parameters are generated at process startup.\",\n  \"context_bytes\": 392,\n  \"statement_bytes\": 472,\n  \"proof_bytes\": 128,\n  \"envelope_bytes\": 652,\n  \"public_input_order\": \"private-contract-domain-Fr, 32 context-digest byte fields, 32 model-commitment byte fields, 32 data-commitment byte fields, three count fields, parent_value, signed output field\",\n  \"public_field_count\": 102,\n  \"state_scope\": \"The complete committed model is a single signed integer weight. The fixed optimizer is stateless SGD, identity preprocessing is pinned, the genesis identifier and value are trusted caller inputs, and exactly one local step is proved per transition. Single-process sequential in-memory chain; persistence, atomic durable writes, rollback resistance, multiworker consensus, identity authentication and authorization are outside the implementation.\",\n  \"exclusions\": [\n    \"production security\",\n    \"aggregate privacy\",\n    \"differential privacy\",\n    \"data authenticity\",\n    \"client participation\",\n    \"preprocessing provenance\",\n    \"general model families\",\n    \"four-client M0 deployment integration\",\n    \"formal cryptographic soundness proof\",\n    \"complete optimizer state beyond the declared stateless SGD configuration\"\n  ]\n}\n",
